{
  "schema_version": "relcompat3d_public_surface_audit_protocol_v1",
  "status": "public_execution_protocol",
  "purpose": "Generate the point- and mesh-based audit from official 3RScan surfaces and freshly fitted RelCompat3D-Linear models.",
  "inputs": {
    "train_scans": "experiments/RelCompat3D_geom_reliability/training_protocol/splits/train_scans.txt",
    "final_validation_scans": "experiments/RelCompat3D_geom_reliability/training_protocol/splits/final_validation_scans.txt",
    "training_table": "experiments/RelCompat3D_geom_reliability/training_protocol/calibration/regenerated/table.jsonl",
    "ground_truth": "local_dataset/RelCompat3D/canonical/ground_truth.jsonl",
    "official_context_annotations": "local_dataset/RelCompat3D/3DSSG_subset/relationships_validation.json",
    "vlsat_verification": "local_dataset/RelCompat3D/canonical/vlsat/verification.jsonl",
    "open3dsg_verification": "local_dataset/RelCompat3D/canonical/open3dsg/verification.jsonl",
    "sgfn_verification": "local_dataset/RelCompat3D/canonical/sgfn/verification.jsonl",
    "strict_models": "experiments/RelCompat3D_geom_reliability/main_experiment/regenerated/fit/strict_models.json",
    "structured_models": "experiments/RelCompat3D_geom_reliability/main_experiment/regenerated/fit/structured_models.json",
    "raw_scan_root": "local_dataset/3RScan/scans"
  },
  "scope": {
    "target": "official 3DSSG validation split",
    "sources": ["vlsat", "open3dsg", "sgfn"],
    "primary_families": ["proximity", "relative_vertical"],
    "methods": ["source", "relcompat3d"],
    "ks": [5, 10, 20, 50, 100]
  },
  "raw_surface_contract": {
    "minimum_metric_scale_m": 0.05,
    "point_audit": {
      "maximum_vertices_per_object": 128
    },
    "mesh_audit": {
      "maximum_triangles_per_object": 96
    }
  },
  "firewall": {
    "obb_measurements_in_audit": false,
    "main_verifier_status_in_audit": false
  },
  "synthetic_intervention": {
    "maximum_cases_per_family": 512,
    "levels_in_pair_scale_units": [0.0, 0.5, 1.0, 2.0]
  },
  "uncertainty": {
    "bootstrap_unit": "scan_id cluster",
    "resamples": 1000,
    "seed": 20260717
  },
  "claim_boundary": "This automatic audit uses alternative measurements from the same official reconstructed scenes and ontology. It is not independent human ground truth or cross-dataset evidence."
}
