{
  "schema_version": "relcompat3d_reproduction_protocol_v1",
  "status": "ready",
  "purpose": "Generate Tables 1--3 and Figure 3 from official data, source-predictor outputs, and freshly fitted RelCompat3D models.",
  "inputs": {
    "ground_truth": {
      "path": "local_dataset/RelCompat3D/prepared/ground_truth.jsonl"
    },
    "vlsat_verification": {
      "path": "local_dataset/RelCompat3D/prepared/vlsat/verification.jsonl"
    },
    "open3dsg_verification": {
      "path": "local_dataset/RelCompat3D/prepared/open3dsg/verification.jsonl"
    },
    "sgfn_verification": {
      "path": "local_dataset/RelCompat3D/prepared/sgfn/verification.jsonl"
    },
    "linear_models": {
      "path": "experiments/relcompat3d/main/regenerated/fit/linear_models.json"
    },
    "mlp_models": {
      "path": "experiments/relcompat3d/main/regenerated/mlp/models.json"
    },
    "official_context_annotations": {
      "path": "local_dataset/RelCompat3D/3DSSG_subset/relationships_validation.json"
    },
    "point_mesh_thresholds": {
      "path": "experiments/relcompat3d/main/regenerated/point_mesh_analysis/thresholds.json"
    },
    "point_mesh_measurements": {
      "path": "experiments/relcompat3d/main/regenerated/point_mesh_analysis/evaluation_measurements.jsonl"
    },
    "identifier_key": {
      "path": "local_dataset/RelCompat3D/secrets/table_rows_hmac_key.txt",
      "distribution": "local only"
    }
  },
  "scope": {
    "sources": ["vlsat", "open3dsg", "sgfn"],
    "families": ["support_contact", "proximity", "relative_vertical"],
    "ks": [5, 10, 20, 50, 100],
    "expected_contexts": 548,
    "expected_scans": 157,
    "expected_ground_truth_rows": 3972
  },
  "wrong_predicate_mapping": {
    "close by": "higher than",
    "higher than": "lower than",
    "lower than": "higher than",
    "lying on": "supported by",
    "standing on": "lying on",
    "supported by": "standing on"
  },
  "row_format": {
    "identifiers": "HMAC-SHA256 local identifiers truncated to 24 hexadecimal characters",
    "included": [
      "predictor",
      "predicate",
      "family",
      "source score",
      "Linear and MLP compatibility",
      "method and control ranks",
      "exact-match flag",
      "primary verifier status",
      "point/mesh agreement status"
    ],
    "excluded": [
      "raw point cloud or mesh",
      "RGB-D frames",
      "OBB measurements",
      "object categories"
    ],
    "redistribution_status": "local only; generated from officially obtained data and predictor outputs"
  },
  "evaluation_scope": "This execution regenerates metrics from the supplied fixed candidates. It does not replace inference in the official source-predictor repositories."
}
